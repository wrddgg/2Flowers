# 阿里云百炼 / DashScope 配置
# 请填写自己的 API Key，不要把真实密钥提交到代码仓库或发送给他人。
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 如果使用业务空间专属域名，请替换为自己的百炼业务空间域名。
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com
QWEN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型配置
QWEN_VL_MODEL=qwen-vl-max
WAN_IMAGE_MODEL=wan2.7-image
WAN_IMAGE_PRO_MODEL=wan2.7-image-pro
WAN_IMAGE_EDIT_MODEL=wan2.7-image-pro
WAN_IMAGE_EDIT_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
WAN_IMAGE_EDIT_SIZE=2K
WAN_IMAGE_EDIT_N=1
WAN_IMAGE_EDIT_WATERMARK=false
WAN_IMAGE_EDIT_MAX_BBOXES=2

# 服务配置
HOST=0.0.0.0
PORT=8001
UPLOAD_DIR=./uploads
